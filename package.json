    "validate": "node scripts/validate.mjs",
    "check": "npm run validate && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "jsdom": "31.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}

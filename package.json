{
  "name": "orca-docker-logs",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "test": "node --import tsx --test src/*.test.ts panel/*.test.ts",
    "test:docker": "node --import tsx scripts/docker-smoke.ts",
